[Desktop Entry]
Version=1.0
Type=Application
Name=Qhostty
GenericName=Terminal Emulator
Comment=Qt terminal emulator powered by Ghostty
TryExec=qhostty
Exec=qhostty
Icon=io.github.dr460nf1r3.qhostty
Categories=System;TerminalEmulator;
Keywords=terminal;shell;prompt;command;commandline;Qt;KDE;
StartupNotify=true
StartupWMClass=io.github.dr460nf1r3.qhostty
Terminal=false
Actions=new-window;
X-TerminalArgExec=-e
X-TerminalArgTitle=--title=
X-TerminalArgAppId=--class=
X-TerminalArgDir=--working-directory=
X-TerminalArgHold=--wait-after-command
DBusActivatable=true

[Desktop Action new-window]
Name=New Window
Exec=qhostty
Icon=io.github.dr460nf1r3.qhostty
